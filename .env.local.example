# === Postcraft — Variables d'environnement ===
#
# Copiez ce fichier en .env.local et remplissez vos clés.
# Ne commitez jamais .env.local dans git.

# OpenAI API Key (requis pour la génération de post et d'image)
# Obtenez votre clé sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Supabase newsletter (requis pour /api/newsletter)
# SUPABASE_URL est l'URL du projet, ex: https://xxxx.supabase.co
SUPABASE_URL=https://xxxx.supabase.co

# Option A recommandee: cle server-only, ne jamais exposer dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Option B possible: cle anon, avec la policy INSERT anon du fichier SQL RLS.
SUPABASE_ANON_KEY=eyJ...
